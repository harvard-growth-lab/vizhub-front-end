# Supply-chain protection: refuse to install package versions published
# less than 7 days ago, giving time for malicious releases to be caught.
# Requires npm >= 11.10.0 (silently ignored on older npm).
min-release-age=7

# Make the engines requirement in package.json a hard error (not a warning),
# so an npm too old to honor min-release-age can't silently skip the cooldown.
engine-strict=true
